# Dev widget + public_key (default npm run dev / npm run build)
VITE_REIH_PUBLIC_KEY=public_key

# Dev widget loader (supports ecommerce mode)
# VITE_REIH_WIDGET_SCRIPT_URL=https://reimaginehome-embed-widget-app-git-dev-styldod.vercel.app/widget.js
# VITE_REIH_API_BASE_URL=https://oetb78o6i5.execute-api.us-west-2.amazonaws.com/dev

# Stage build (npm run dev:stage / npm run build:stage) — see .env.stage
# VITE_REIH_ENV=stage
# VITE_REIH_WIDGET_SCRIPT_URL=https://stage-widget.styldod.com/widget.js
# VITE_REIH_API_BASE_URL=https://stage-ep-api.styldod.com

# Production (requires real ppk_ key + simple/agentic mode only):
# VITE_REIH_WIDGET_SCRIPT_URL=https://widget.styldod.com/widget.js
# VITE_REIH_API_BASE_URL=https://ep-api.styldod.com
# VITE_REIH_PUBLIC_KEY=ppk_live_xxx
